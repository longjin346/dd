# Decision Bank target — where published records go.
#
# Key="value" so `publish.sh` can source it directly: no YAML parser, no
# dependency, and the publisher is a shell script that will drive the GitLab
# CLI. Quote every value — an unquoted one containing a space or a colon
# breaks the source. Everything here describes a destination.
#
# NO CREDENTIALS IN THIS FILE. The token lives in the environment
# publish.sh runs in, defined wherever you already define it. Nothing here
# is secret, and this file is committed.
#
# Every value below marked CHANGE_ME must be set before a publish can
# succeed. publish.sh refuses to run while any of them is unset, which is
# deliberate: a half-configured publisher that guesses a destination is the
# one failure mode with no symptom.

# --- Where the Bank lives -------------------------------------------------

# GitLab host. Just the hostname, no scheme.
BANK_HOST="CHANGE_ME"

# Project path, as GitLab writes it: group/subgroup/repo
BANK_PROJECT="CHANGE_ME"

# Branch that records are written to. There is no CI and no merge request in
# the loop — the publisher pushes here directly and the write is done when it
# returns.
BANK_BRANCH="main"

# --- Layout inside the repo ----------------------------------------------

# Directory for Decision records, relative to the repo root. One file per
# Decision.
BANK_DECISIONS_DIR="decisions"

# Directory for Action records. One file per Action; each carries the
# permanent linked_decision_id the publisher derives at write time.
BANK_ACTIONS_DIR="actions"

# Filename pattern. {id} is the permanent record id the publisher assigns.
BANK_FILENAME="%s.json"

# --- What the reviewer gets back -----------------------------------------

# Template for the record_url returned per written record, so the save
# message can link to it. {path} is the file's path inside the repo.
# Leave as is unless your GitLab serves files from somewhere unusual.
BANK_RECORD_URL="https://${BANK_HOST}/${BANK_PROJECT}/-/blob/${BANK_BRANCH}/%s"

# --- Write behaviour ------------------------------------------------------

# The write is non-overwriting: publishing an edited Decision creates a new
# record rather than replacing an earlier one. Kept here as a setting because
# it is a property of the destination, but the skill assumes `true` and
# review.md documents supersession as an open question, so changing it needs
# that question answered first.
BANK_NON_OVERWRITING="true"

# Message used for each push.
BANK_COMMIT_MESSAGE="Decision Bank: add %s"
